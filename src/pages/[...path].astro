---
import Work from "../components/Work.astro";
import Life from "../components/Life.astro";
import About from "../components/About.astro";
import Case from "../components/Case.astro";
import { locales, pages, projects, type Locale } from "../i18n";

export const getStaticPaths = () =>
  (Object.keys(locales) as Locale[]).flatMap((locale) =>
    pages.map((page) => ({
      params: { path: [locale === "en" ? "" : locale, page].filter(Boolean).join("/") || undefined },
      props: { locale, page },
    })),
  );

const { locale, page } = Astro.props;
const views = { "": Work, life: Life, about: About };
const project = page.startsWith("work/") ? (page.slice(5) as keyof typeof projects) : null;
const View = views[page as keyof typeof views];
---

{project ? <Case locale={locale} project={project} /> : <View locale={locale} />}
