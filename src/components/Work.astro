---
import Base from "../layouts/Base.astro";
import Tile from "./Tile.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Brand from "./Brand.astro";
import Socials from "./Socials.astro";
import Contact from "./Contact.astro";
import Photo from "./Photo.astro";
import Stack from "./Stack.astro";
import { locales, timeline, ongoing, href, type Locale, type Page } from "../i18n";

interface Props {
  locale: Locale;
  page?: Page;
  title?: string;
}

const { locale, page = "", title: pageTitle } = Astro.props;
const t = locales[locale];
const eyebrow = "text-[11px] font-medium tracking-[0.22em] text-muted uppercase";
const title = "text-[1.4rem] leading-snug font-medium tracking-[-0.015em]";
const body = "text-[0.9rem] leading-relaxed text-muted";
---

<Base locale={locale} page={page} title={pageTitle ?? t.meta.title}>
  <div class="grid h-full grid-cols-1 gap-2 sm:grid-cols-2 md:gap-3 lg:grid-cols-12 lg:grid-rows-3">
    <div class="flex flex-col gap-2 sm:col-span-2 md:gap-3 lg:col-span-9 lg:flex-row">
      <Tile i={0} class="flex min-h-80 flex-col justify-between gap-4 lg:min-h-0 lg:min-w-0 lg:flex-1">
        <Brand locale={locale} page="" />
        <div>
          <h1 class="text-[clamp(2rem,0.6rem+2.2vw,3.4rem)] leading-[1.05] font-medium tracking-[-0.03em]">{t.hero.hi}</h1>
          <p class="mt-4 max-w-[56ch] text-[1.05rem] leading-relaxed text-muted xl:text-lg">{t.hero.intro}</p>
        </div>
      </Tile>

      <Tile i={1} bare class="aspect-square lg:h-full">
        <Photo name="me" alt="Leonardo Caero Ledezma" icon="user" eager />
      </Tile>
    </div>

    <Tile i={4} class="flex min-h-64 flex-col justify-between gap-6 sm:col-span-2 lg:col-span-5 lg:min-h-0">
      <div class="absolute inset-0 bg-[radial-gradient(90%_130%_at_100%_0%,rgb(47_91_211/0.3),transparent_60%)]"></div>
      <p class:list={["relative", eyebrow]}>{t.featured.label}</p>
      <div class="relative">
        <h2 class:list={[title, "font-mono"]}>jacaero-platform</h2>
        <p class="mt-1">{t.featured.tagline}</p>
        <p class:list={["mt-3 max-w-[56ch]", body]}>{t.featured.body}</p>
      </div>
    </Tile>

    <Tile i={5} class="flex min-h-64 flex-col justify-between gap-6 sm:col-span-2 lg:col-span-4 lg:min-h-0">
      <div class="absolute inset-0 bg-[radial-gradient(90%_130%_at_100%_0%,rgb(242_194_48/0.16),transparent_60%)]"></div>
      <p class:list={["relative", eyebrow]}>{t.side.label}</p>
      <div class="relative">
        <h2 class:list={[title, "font-mono"]}>benchlog</h2>
        <p class="mt-1">{t.side.tagline}</p>
        <p class:list={["mt-3 max-w-[48ch]", body]}>{t.side.body}</p>
      </div>
    </Tile>

    <div class="flex flex-col gap-2 sm:col-span-2 md:gap-3 lg:col-span-3 lg:col-start-10 lg:row-span-2 lg:row-start-1">
      <div class="grid grid-cols-2 gap-2 md:gap-3">
        <Socials locale={locale} i={2} />
        <Tile i={3} bare class="grid aspect-square place-items-center">
          <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_30%_10%,#4a76ec_0%,#2f5bd3_45%,#1c3a93_100%)]"></div>
          <Logo class="relative w-1/2 text-white" title="caero DEV" />
          <span class="absolute bottom-[12%] left-1/2 flex h-1 w-8 -translate-x-1/2 overflow-hidden rounded-full" aria-hidden="true">
            <span class="flex-1 bg-white"></span><span class="flex-1 bg-rx-red"></span><span class="flex-1 bg-rx-yellow"></span>
          </span>
        </Tile>
      </div>
      <Tile i={6} class="flex min-h-80 flex-1 flex-col gap-5 lg:min-h-0">
        <h2 class={eyebrow}>{t.experience}</h2>
        <ol class="space-y-2 text-[0.85rem]">
          {timeline.map((e) => (
            <li class="flex items-baseline justify-between gap-3">
              <span class:list={[ongoing.has(e.key) ? "text-fg" : "text-muted"]}>{e.org}</span>
              <span class="font-mono text-[11px] whitespace-nowrap text-muted">
                {ongoing.has(e.key) ? `${e.period} – ${t.timeline.now}` : e.period}
              </span>
            </li>
          ))}
        </ol>
      </Tile>
    </div>

    <Tile i={7} class="flex flex-col justify-between gap-6 sm:col-span-2 lg:col-span-4">
      <Icon name="stack" class="size-6 text-rx-blue-soft" />
      <div>
        <h2 class={title}>{t.ai.title}</h2>
        <p class:list={["mt-2 max-w-[48ch]", body]}>{t.ai.body}</p>
      </div>
    </Tile>

    <Tile i={8} class="flex flex-col justify-between gap-6 sm:col-span-2 lg:col-span-3">
      <h2 class={title}>{t.stack.title}</h2>
      <div class="-mx-6 md:-mx-7">
        <Stack />
      </div>
    </Tile>

    <Tile i={9} go="down" href={href(locale, "life")} class="flex min-h-56 flex-col justify-between gap-6 lg:col-span-2 lg:min-h-0">
      <div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_100%_100%,rgb(214_55_47/0.28),rgb(242_194_48/0.06)_55%,transparent_80%)]"></div>
      <span class="relative flex h-1 w-10 overflow-hidden rounded-full" aria-hidden="true">
        <span class="flex-1 bg-rx-blue"></span><span class="flex-1 bg-rx-red"></span><span class="flex-1 bg-rx-yellow"></span>
      </span>
      <div class="relative pr-14 lg:pr-0 lg:pb-14">
        <h2 class="text-xl leading-snug font-medium tracking-[-0.015em]">{t.life.intro.title}</h2>
        <p class="mt-1 text-xs text-muted" lang="ja">日本・ガンプラ・3D</p>
      </div>
    </Tile>

    <Contact locale={locale} i={10} class="lg:col-span-3" />
  </div>
</Base>
