---
import Logo from "./Logo.astro";
import { locales, href, type Locale, type Page } from "../i18n";

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const t = locales[locale];
---

<div class="flex items-center justify-between gap-4">
  <a href={href(locale)} aria-label={t.nav.home} class="transition-opacity hover:opacity-80">
    <Logo class="w-10 text-fg" />
  </a>
  <nav class="flex rounded-full border border-white/8 bg-black/20 p-1 font-mono text-[11px]" aria-label={t.nav.language}>
    {(Object.keys(locales) as Locale[]).map((l) => (
      <a
        href={href(l, page)}
        hreflang={l}
        lang={l}
        aria-current={l === locale ? "true" : undefined}
        class="rounded-full px-3 py-1.5 uppercase text-muted transition-colors hover:text-fg aria-current:bg-white/10 aria-current:text-fg"
      >
        {l}
      </a>
    ))}
  </nav>
</div>
