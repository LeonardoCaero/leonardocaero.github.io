---
import "@fontsource-variable/hanken-grotesk";
import "@fontsource-variable/geist-mono";
import jp400 from "@fontsource/noto-sans-jp/400.css?url";
import jp500 from "@fontsource/noto-sans-jp/500.css?url";
import jp700 from "@fontsource/noto-sans-jp/700.css?url";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { locales, href, type Locale, type Page } from "../i18n";

interface Props {
  locale: Locale;
  page: Page;
  title: string;
}

const { locale, page, title } = Astro.props;
const t = locales[locale];
const site = Astro.site!;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(href(locale, page), site)} />
    {(Object.keys(locales) as Locale[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(href(l, page), site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(href("en", page), site)} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={new URL(href(locale, page), site)} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    {locale === "ja" && [jp400, jp500, jp700].map((f) => <link rel="stylesheet" href={f} />)}
    <ClientRouter />
  </head>
  <body class="font-sans">
    <div class="p-2 md:p-4 xl:h-dvh xl:min-h-208">
      <main class="h-full rounded-[40px] border border-white/5 bg-frame p-2 md:p-3">
        <slot />
      </main>
    </div>
    <slot name="overlay" />
    <script>
      let marquee: CSSNumberish | null | undefined;
      let opener: string | null = null;
      let y: number | null = null;
      document.addEventListener("astro:before-swap", (e) => {
        marquee = document.querySelector(".animate-marquee")?.getAnimations()[0]?.currentTime;
        const from = !!document.querySelector("[data-sheet]");
        const to = !!e.newDocument.querySelector("[data-sheet]");
        if (!from && to) {
          opener = document.activeElement?.getAttribute("href") ?? null;
          y = scrollY;
        } else if (!from || to) y = null;
      });
      document.addEventListener("astro:after-swap", () => {
        if (marquee != null) document.querySelectorAll(".animate-marquee").forEach((m) => m.getAnimations().forEach((a) => (a.currentTime = marquee!)));
        if (y != null) scrollTo(0, y);
      });
      document.addEventListener("astro:page-load", () => {
        const bento = document.querySelector("[data-bento]");
        const close = document.querySelector<HTMLElement>("[data-close]");
        bento?.toggleAttribute("inert", !!close);
        (close ?? (opener ? bento?.querySelector<HTMLElement>(`[href="${opener}"]`) : null))?.focus({ preventScroll: true });
        if (!close) opener = null;
        setTimeout(() => bento?.classList.add("settled"), 1500);
      });
    </script>
    <script>
      import { navigate } from "astro:transitions/client";

      type Dir = "left" | "down" | "up";
      const band = (t: Element, grid: Element, axis: "x" | "y", n: number) => {
        const g = grid.getBoundingClientRect();
        const r = t.getBoundingClientRect();
        const f = axis === "y" ? (r.top - g.top) / g.height : (r.left - g.left) / g.width;
        return Math.min(n - 1, Math.max(0, Math.floor(f * n)));
      };
      const isLife = (path: string) => /\/life\/?$/.test(path);
      let ghost: HTMLElement | null = null;
      let dir: Dir = "left";
      let running: Animation[] = [];

      document.addEventListener("click", (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>("main a[href]");
        if (!a || ghost || a.origin !== location.origin || a.pathname === location.pathname || a.hasAttribute("download")) return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (a.hasAttribute("hreflang")) dir = "left";
        else if (isLife(a.pathname) && !isLife(location.pathname)) dir = "down";
        else if (isLife(location.pathname) && !isLife(a.pathname)) dir = "up";
        else return;
        e.preventDefault();
        e.stopPropagation();
        const main = document.querySelector("main")!;
        const grid = main.firstElementChild as HTMLElement;
        const m = main.getBoundingClientRect();
        const g = grid.getBoundingClientRect();
        ghost = grid.cloneNode(true) as HTMLElement;
        Object.assign(ghost.style, { position: "absolute", left: `${g.left - m.left - main.clientLeft}px`, top: `${g.top - m.top - main.clientTop}px`, width: `${g.width}px`, height: `${g.height}px`, pointerEvents: "none" });
        ghost.removeAttribute("data-bento");
        ghost.removeAttribute("data-astro-transition-persist");
        ghost.inert = true;
        ghost.querySelectorAll("img").forEach((i) => ((i.loading = "eager"), (i.decoding = "sync")));
        navigate(a.href);
      }, true);

      document.addEventListener("astro:after-swap", () => {
        if (!ghost) return;
        const main = document.querySelector("main")!;
        const grid = main.firstElementChild as HTMLElement;
        const old = ghost;
        ghost = null;
        main.classList.add("relative", "overflow-hidden");
        main.append(old);
        const vertical = dir !== "left";
        const dist = vertical ? Math.min(main.clientHeight, innerHeight) : main.clientWidth;
        const sign = dir === "up" ? 1 : -1;
        const move = (d: number) => (vertical ? `translateY(${d}px)` : `translateX(${d}px)`);
        const step = (t: Element, from: Element) =>
          vertical ? (dir === "up" ? 3 - band(t, from, "x", 4) : band(t, from, "x", 4)) : band(t, from, "y", 3);
        const opts = (t: Element, from: Element) => ({ duration: 750, delay: step(t, from) * (vertical ? 70 : 90), easing: "cubic-bezier(0.65, 0, 0.35, 1)" });
        // inline animation:none, not cancel(): a cancelled css animation replays if the bento is moved into a sheet page
        const slide = (t: HTMLElement, from: Element, frames: Keyframe[], fill: FillMode) => {
          t.style.animation = "none";
          return t.animate(frames, { ...opts(t, from), fill });
        };
        running = [
          ...[...old.querySelectorAll<HTMLElement>(".rise")].map((t) => slide(t, old, [{ transform: "none" }, { transform: move(sign * dist) }], "forwards")),
          ...[...grid.querySelectorAll<HTMLElement>(".rise")].map((t) => slide(t, grid, [{ transform: move(-sign * dist) }, { transform: "none" }], "backwards")),
        ];
        Promise.all(running.map((a) => a.finished)).catch(() => {}).then(() => {
          running = [];
          old.remove();
          main.classList.remove("relative", "overflow-hidden");
        });
      });

      document.addEventListener("astro:before-preparation", () => running.forEach((a) => a.finish()));
    </script>
  </body>
</html>
